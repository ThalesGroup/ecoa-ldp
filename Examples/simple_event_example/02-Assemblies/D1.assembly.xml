<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://www.ecoa.technology/Assembly/3.0">

  <instance name="Sender" componentType="Sender" implementation="C"/>
  <instance name="Receiver1" componentType="Receiver" implementation="C"/>
  <instance name="Receiver2" componentType="Receiver" implementation="C"/>

  
  <links>
    <dataLink>
        <writer instance="Sender" operation="myData_write"/>
        <reader instance="Sender" operation="myData_read"/>
        <reader instance="Receiver1" operation="myData"/>
        <reader instance="Receiver2" operation="myData"/>
    </dataLink>
    <eventLink>
        <sender instance="Sender" operation="myEvent"/>
        <receiver instance="Receiver1" operation="myEvent"/>
    </eventLink>
    <eventLink>
        <sender instance="Sender" operation="myEvent"/>
        <receiver instance="Receiver2" operation="myEvent"/>
    </eventLink>
    
  </links>
</assembly>
